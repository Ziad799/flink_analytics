<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_flink" model="ir.module.category">
        <field name="name">Flink Analytics</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_flink_user" model="res.groups">
        <field name="name">Flink Analytics / User</field>
        <field name="comment">Can create and run own analyses.</field>
    </record>

    <record id="group_flink_manager" model="res.groups">
        <field name="name">Flink Analytics / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_flink_user'))]"/>
        <field name="comment">Can see and manage all analyses.</field>
    </record>

    <record id="rule_flink_analysis_user" model="ir.rule">
        <field name="name">Flink Analysis: own records</field>
        <field name="model_id" ref="model_flink_analysis"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_flink_user'))]"/>
    </record>

    <record id="rule_flink_analysis_manager" model="ir.rule">
        <field name="name">Flink Analysis: all records</field>
        <field name="model_id" ref="model_flink_analysis"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_flink_manager'))]"/>
    </record>
</odoo>
